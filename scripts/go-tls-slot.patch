diff --git a/src/cmd/link/internal/ld/sym.go b/src/cmd/link/internal/ld/sym.go
index 6ae1106..31e382d 100644
--- a/src/cmd/link/internal/ld/sym.go
+++ b/src/cmd/link/internal/ld/sym.go
@@ -101,13 +101,16 @@ func (ctxt *Link) computeTLSOffset() {
 
 			/*
 			 * For x86, Apple has reserved a slot in the TLS for Go. See issue 23617.
-			 * That slot is at offset 0x30 on amd64.
+			 * That slot is at offset 0x30 on amd64. This patched toolchain uses
+			 * slot 11 (offset 0x58), Apple's other reserved Win64 slot, instead, so
+			 * a runtime loaded as a plugin into a Go host does not share the host
+			 * runtime's slot.
 			 * The slot will hold the G pointer.
 			 * These constants should match those in runtime/sys_darwin_amd64.s
 			 * and runtime/cgo/gcc_darwin_amd64.c.
 			 */
 		case sys.AMD64:
-			ctxt.Tlsoffset = 0x30
+			ctxt.Tlsoffset = 0x58
 
 		case sys.ARM64:
 			ctxt.Tlsoffset = 0 // dummy value, not needed
diff --git a/src/runtime/sys_darwin_amd64.s b/src/runtime/sys_darwin_amd64.s
index 6ff95ea..a8a2458 100644
--- a/src/runtime/sys_darwin_amd64.s
+++ b/src/runtime/sys_darwin_amd64.s
@@ -395,7 +395,7 @@ TEXT runtime·mstart_stub(SB),NOSPLIT|NOFRAME,$0
 
 	// Initialize TLS entry.
 	// See cmd/link/internal/ld/sym.go:computeTLSOffset.
-	MOVQ	DX, 0x30(GS)
+	MOVQ	DX, 0x58(GS)
 
 	CALL	runtime·mstart(SB)
 
